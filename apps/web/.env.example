# Base URL of the FastAPI gateway (without /api/v1). Leave empty to use the sample.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Force the sample regardless of API availability: 1 = on
NEXT_PUBLIC_API_MOCK=0
# Search page size. /search?limit= overrides this. Default 20.
# NEXT_PUBLIC_SEARCH_LIMIT=20
# Optional cap forwarded to GET /galaxy. Unset requests every node.
# NEXT_PUBLIC_GALAXY_LIMIT=
